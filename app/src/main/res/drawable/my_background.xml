<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Базовый синий градиент -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#011135"
                android:endColor="#1F2973"
                android:angle="315" />
        </shape>
    </item>

    <!-- Крупный лист, уходит за верхний левый край -->
    <item
        android:drawable="@drawable/bg_food_leaf"
        android:gravity="top|left"
        android:left="-45dp"
        android:top="-35dp"
        android:width="185dp"
        android:height="185dp" />

    <!-- Крупный огонёк, уходит за нижний правый край -->
    <item
        android:drawable="@drawable/bg_food_flame"
        android:gravity="bottom|right"
        android:right="-48dp"
        android:bottom="-55dp"
        android:width="205dp"
        android:height="205dp" />

    <!-- Острый перец, акцент справа -->
    <item
        android:drawable="@drawable/bg_food_pepper"
        android:gravity="right"
        android:right="22dp"
        android:width="78dp"
        android:height="78dp" />

    <!-- Небольшая капля, акцент сверху справа -->
    <item
        android:drawable="@drawable/bg_food_drop"
        android:gravity="top|right"
        android:top="155dp"
        android:right="58dp"
        android:width="46dp"
        android:height="46dp" />

</layer-list>
