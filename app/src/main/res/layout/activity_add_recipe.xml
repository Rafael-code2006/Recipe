<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/my_background">

    <!-- Прокручиваемая часть -->
    <ScrollView
        android:id="@+id/ScrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/RecipeSaveButton">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="120dp"> <!-- добавляем отступ снизу -->

            <TextView
                android:id="@+id/CreateRecipeTextView"
                android:layout_width="350dp"
                android:layout_height="62dp"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/archivo_black"
                android:gravity="left"
                android:text="Add Recipe"
                android:textColor="@color/my_text_view_back"
                android:textSize="40sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/TextViewRecipeName"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/archivo_black"
                android:text="Recipe name"
                android:textColor="@color/my_text_view_back"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/CreateRecipeTextView" />

            <EditText
                android:id="@+id/EditTextRecipe"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="350dp"
                android:layout_height="55dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/textview_border"
                android:fontFamily="@font/archivo_black"
                android:gravity="start"
                android:hint="name"
                android:inputType="text"
                android:paddingTop="17dp"
                android:paddingBottom="5dp"
                android:textColor="#DCDCDC"
                android:textColorHint="#979595"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/TextViewRecipeName" />

            <LinearLayout
                android:id="@+id/linearLayoutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/EditTextRecipe"
                tools:listitem="@layout/ingredient_item" />

            <TextView
                android:id="@+id/TextViewInstructionRecipe"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/archivo_black"
                android:text="Instruction"
                android:textColor="@color/my_text_view_back"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linearLayoutDescription" />

            <EditText
                android:id="@+id/EditTextInsctructionRecipe"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:minHeight="200dp"
                android:background="@drawable/textview_border"
                android:ellipsize="none"
                android:fontFamily="@font/archivo_black"
                android:gravity="top|start"
                android:hint="instruction"
                android:inputType="textMultiLine"
                android:scrollHorizontally="false"
                android:singleLine="false"
                android:paddingTop="17dp"
                android:paddingBottom="5dp"
                android:textColor="#DCDCDC"
                android:textColorHint="#979595"
                android:textSize="14sp"
                android:scrollbars="vertical"
                android:maxLines="10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/TextViewInstructionRecipe"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- FAB закреплён справа снизу -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:backgroundTint="@color/background_main"
        android:clickable="true"
        android:contentDescription="@string/app_name"
        app:srcCompat="@drawable/ic_add_recipe"
        app:layout_constraintBottom_toTopOf="@id/RecipeSaveButton"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Кнопка Save закреплена внизу -->
    <Button
        android:id="@+id/RecipeSaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        android:backgroundTint="@color/my_textView_gray"
        android:text="Save"
        android:textColor="#DCDCDC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>