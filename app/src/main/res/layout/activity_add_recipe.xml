<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/my_background">


    <!-- Заголовок -->
    <TextView
        android:id="@+id/CreateRecipeTextView"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp"
        android:fontFamily="@font/open_sans_bold"
        android:gravity="left"
        android:text="Add Recipe"
        android:textColor="@color/white"
        android:textSize="35sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Линия -->
    <View
        android:id="@+id/lineUnderText"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/CreateRecipeTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



    <!-- Прокручиваемая часть начинается сразу после линии -->
    <ScrollView
        android:id="@+id/ScrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginBottom="70dp"
        app:layout_constraintTop_toBottomOf="@id/lineUnderText"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/LinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewRecipeImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    android:id="@+id/recipeImageView"
                    android:layout_width="350dp"
                    android:layout_height="250dp"
                    android:src="@drawable/steak"
                    android:scaleType="centerCrop"
                    android:contentDescription="Recipe photo"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/TextViewRecipeName"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/archivo_black"
                android:text="Recipe name"
                android:textColor="@color/title_my_color"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:padding="12dp"
                app:cardBackgroundColor="@color/my_recipes_background"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                app:cardUseCompatPadding="true">

                <EditText
                    android:id="@+id/EditTextRecipe"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="name"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:textColor="@color/my_textView_gray"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="13sp"
                    android:background="@null"/>
            </androidx.cardview.widget.CardView>


            <TextView
                android:id="@+id/TextViewIngredient"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/archivo_black"
                android:text="Ingredients"
                android:layout_gravity="center"
                android:textColor="@color/title_my_color"
                android:textSize="19sp"
                android:textStyle="bold"
                app:tint="@android:color/white" />


            <LinearLayout
                android:id="@+id/linearLayoutDescription"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="vertical"
                tools:listitem="@layout/ingredient_item"/>

            <TextView
                android:id="@+id/TextViewInstructionRecipe"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/archivo_black"
                android:text="Instruction"
                android:textColor="@color/title_my_color"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="100dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/my_recipes_background">

                <EditText
                    android:id="@+id/EditTextInsctructionRecipe"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Instruction"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:minHeight="180dp"
                    android:scrollbars="vertical"
                    android:overScrollMode="always"
                    android:padding="12dp"
                    android:textColor="@color/my_textView_gray"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="13sp"
                    android:background="@null"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Кнопка Save закреплена внизу -->

    <ImageButton
        android:id="@+id/addIngredientButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="end"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/bg_add_button"
        android:clickable="true"
        android:contentDescription="@string/app_name"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toTopOf="@+id/CardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/white" />

    <androidx.cardview.widget.CardView
        android:id="@+id/CardView"
        android:layout_width="350dp"
        android:layout_height="50dp"
        app:cardElevation="8dp"
        android:layout_margin="40dp"
        app:cardCornerRadius="120dp"
        android:layout_marginBottom="30dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@+id/bottomMenuAdd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/RecipeSaveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save"
            android:elevation="8dp"
            android:backgroundTint="@color/white"
            android:textColor="@color/black"/>
    </androidx.cardview.widget.CardView>

    <!-- Нижнее меню -->
    <include
        android:id="@+id/bottomMenuAdd"
        layout="@layout/bottom_menu"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>