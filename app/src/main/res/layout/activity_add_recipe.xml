<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".AddRecipe">

    <TextView
        android:id="@+id/CreateRecipeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:gravity="center"
        android:text="Create Recipe"
        android:textSize="30dp"
        app:layout_constraintTop_toTopOf="@id/main" />

    <EditText
        style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
        android:id="@+id/EditTextRecipe"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="30dp"
        android:background="@color/white"
        android:gravity="left"
        android:hint="Name"

        android:inputType="text"
        android:paddingBottom="5dp"
        app:layout_constraintTop_toBottomOf="@id/CreateRecipeTextView"
        tools:layout_editor_absoluteX="20dp" />
    <Space
        android:layout_width="match_parent"
        android:layout_height="12dp"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/edit_recipe_description"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_margin="30dp"
        android:background="@color/white"
        android:gravity="top"
        android:hint="Description"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:padding="12dp"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@+id/EditTextRecipe"
        tools:layout_editor_absoluteX="20dp" />

    <Button
        android:id="@+id/RecipeSaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        android:layout_marginTop="164dp"
        android:backgroundTint="@color/black"
        android:text="Save"
        app:layout_constraintTop_toBottomOf="@id/edit_recipe_description"
        tools:layout_editor_absoluteX="34dp" />


</androidx.constraintlayout.widget.ConstraintLayout>