<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/my_background">


    <!-- Заголовок -->
    <TextView
        android:id="@+id/CreateRecipeTextView"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="30dp"
        android:fontFamily="@font/open_sans_bold"
        android:gravity="left"
        android:text="Add Recipe"
        android:textColor="@color/my_text_view_back"
        android:textSize="35sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Линия под заголовком (фиксированная) -->
    <View
        android:id="@+id/lineUnderText"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#888888"
        app:layout_constraintTop_toBottomOf="@id/CreateRecipeTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



    <!-- Прокручиваемая часть начинается сразу после линии -->
    <ScrollView
        android:id="@+id/ScrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginBottom="70dp"
        app:layout_constraintTop_toBottomOf="@id/lineUnderText"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/LinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewRecipeImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@android:color/transparent">

                <ImageView
                    android:id="@+id/recipeImageView"
                    android:layout_width="350dp"
                    android:layout_height="250dp"
                    android:src="@drawable/america"
                    android:scaleType="centerCrop"
                    android:contentDescription="Recipe photo"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/TextViewRecipeName"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/archivo_black"
                android:text="Recipe name"
                android:textColor="@color/my_text_view_back"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:padding="12dp"
                app:cardBackgroundColor="@color/my_recipes_background"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                app:cardUseCompatPadding="true">

                <EditText
                    android:id="@+id/EditTextRecipe"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:hint="name"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:textColor="@color/my_textView_gray"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="13sp"
                    android:background="@null"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/linearLayoutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:listitem="@layout/ingredient_item"/>

            <TextView
                android:id="@+id/TextViewInstructionRecipe"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/archivo_black"
                android:text="Instruction"
                android:textColor="@color/my_text_view_back"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardElevation="6dp"
                app:cardCornerRadius="12dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/my_recipes_background">

                <EditText
                    android:id="@+id/EditTextInsctructionRecipe"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Instruction"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:minHeight="180dp"
                    android:scrollbars="vertical"
                    android:overScrollMode="always"
                    android:padding="12dp"
                    android:textColor="@color/my_textView_gray"
                    android:textColorHint="@android:color/darker_gray"
                    android:textSize="13sp"
                    android:background="@null"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- FAB закреплён справа снизу -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toTopOf="@id/CardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:backgroundTint="@color/background_floatingButton"
        app:srcCompat="@drawable/ic_add_recipe"
        app:tint="@color/black" />

    <!-- Кнопка Save закреплена внизу -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CardView"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        android:layout_margin="40dp"
        app:cardCornerRadius="120dp"
        android:layout_marginBottom="30dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/RecipeSaveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save"
            android:elevation="8dp"
            android:backgroundTint="@color/background_floatingButton"
            android:textColor="@color/black"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>