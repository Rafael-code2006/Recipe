<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/my_background">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/CreateRecipeTextView"
        android:layout_width="350dp"
        android:layout_height="62dp"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/archivo_black"
        android:gravity="left"
        android:text="Add Recipe"
        android:textColor="@color/my_text_view_back"
        android:textSize="40sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Линия под заголовком (фиксированная) -->
    <View
        android:id="@+id/lineUnderText"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#888888"
        app:layout_constraintTop_toBottomOf="@id/CreateRecipeTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Прокручиваемая часть начинается сразу после линии -->
    <ScrollView
        android:id="@+id/ScrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginBottom="70dp"
        app:layout_constraintTop_toBottomOf="@id/lineUnderText"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/LinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <TextView
                android:id="@+id/TextViewRecipeName"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/archivo_black"
                android:text="Recipe name"
                android:textColor="@color/my_text_view_back"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewRecipeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="7dp"
                android:padding="8dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="5dp"
                app:cardCornerRadius="10dp"
                app:cardUseCompatPadding="true">

                <EditText
                    android:id="@+id/EditTextRecipe"
                    style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                    android:layout_width="350dp"
                    android:layout_height="wrap_content"
                    android:minHeight="55dp"
                    android:fontFamily="@font/archivo_black"
                    android:gravity="start"
                    android:background="@drawable/textview_border"
                    android:hint="name"
                    android:inputType="text"
                    android:paddingStart="20dp"
                    android:textColor="#DCDCDC"
                    android:textColorHint="#979595"
                    android:textSize="14sp"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/linearLayoutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:listitem="@layout/ingredient_item"/>

            <TextView
                android:id="@+id/TextViewInstructionRecipe"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:fontFamily="@font/archivo_black"
                android:text="Instruction"
                android:textColor="@color/my_text_view_back"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/CardViewInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardElevation="8dp"
                app:cardCornerRadius="12dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@android:color/transparent"
                android:layout_marginTop="7dp"
                android:layout_gravity="center"
                >

            <EditText
                android:id="@+id/EditTextInsctructionRecipe"
                style="@style/Widget.Material3.AutoCompleteTextView.OutlinedBox"
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:minHeight="200dp"
                android:background="@drawable/textview_border"
                android:fontFamily="@font/archivo_black"
                android:gravity="top|start"
                android:hint="instruction"
                android:inputType="textMultiLine"
                android:scrollHorizontally="false"
                android:singleLine="false"
                android:textColor="#DCDCDC"
                android:textColorHint="#979595"
                android:textSize="14sp"
                android:scrollbars="vertical"
                android:maxLines="10"/>
        </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- FAB закреплён справа снизу -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:contentDescription="@string/app_name"
        app:backgroundTint="@color/fab_background"
        app:layout_constraintBottom_toTopOf="@id/CardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add_recipe"
        app:tint="@android:color/white" />

    <!-- Кнопка Save закреплена внизу -->

    <androidx.cardview.widget.CardView
        android:id="@+id/CardView"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardCornerRadius="120dp"
        android:layout_marginBottom="30dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/RecipeSaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:elevation="8dp"
            android:backgroundTint="@color/my_button_background"
            android:textColor="#FFFFFF"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>