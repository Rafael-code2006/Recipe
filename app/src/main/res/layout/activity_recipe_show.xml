<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".RecipeShow">

    <TextView
        android:id="@+id/YourRecipeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/adamina"
        android:gravity="center"
        android:text="Your recipe"
        android:textColor="@color/my_textView_gray"
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/RecipeTextViewShow"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:text="Recipe"
        android:textSize="28sp"
        android:gravity="center"
        android:layout_marginTop="30dp"
        android:background="@drawable/textview_border"
        android:textColor="#DCDCDC"
        app:layout_constraintTop_toBottomOf="@id/YourRecipeTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <EditText
        android:id="@+id/EditRecipeShow"
        android:layout_width="300dp"
        android:layout_height="70dp"
        android:hint="input name"
        android:textColorHint="#DCDCDC"
        android:textSize="28sp"
        android:paddingTop="15dp"
        android:paddingStart="10dp"
        android:gravity="left"
        android:layout_marginTop="30dp"
        android:background="@drawable/textview_border"
        android:textColor="#CCCBCB"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/YourRecipeTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />


    <ScrollView
        android:id="@+id/ScrollDiscription"
        android:layout_width="350dp"
        android:layout_height="250dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/RecipeTextViewShow"
        android:fillViewport="true"
        android:background="@drawable/rounded_textview"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/RecipeDiscriptionTVShow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Discriptions"
            android:textSize="20sp"
            android:gravity="left"
            android:paddingBottom="50dp"
            android:paddingStart="10dp"
            android:layout_marginTop="40dp"
            android:textColor="#DCDCDC"
            />
    </ScrollView>


    <EditText
        android:id="@+id/EditRecipeDiscription"
        android:layout_width="350dp"
        android:layout_height="250dp"
        android:hint="input discriptions"
        android:textColorHint="#CCCBCB"
        android:textSize="20sp"
        android:gravity="left"
        android:paddingTop="10dp"
        android:paddingStart="10dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/rounded_textview"
        android:textColor="#DCDCDC"
        android:singleLine="false"
        android:lines="3"
        android:maxLines="5"
        android:ellipsize="end"
        android:breakStrategy="simple"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/RecipeTextViewShow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <Button
        android:id="@+id/RecipeSaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        android:layout_marginTop="164dp"
        android:backgroundTint="@color/my_textView_gray"
        android:text="Edit"
        android:textColor="#DCDCDC"
        app:layout_constraintTop_toBottomOf="@id/ScrollDiscription"
        tools:layout_editor_absoluteX="34dp" />

</androidx.constraintlayout.widget.ConstraintLayout>