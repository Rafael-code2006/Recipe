<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"

    app:cardBackgroundColor="#263B8C"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"

    app:strokeColor="#344B9D"
    app:strokeWidth="1dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">


        <!-- =============================== -->
        <!-- ЗАГОЛОВОК -->
        <!-- =============================== -->

        <TextView
            android:id="@+id/quantityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Количество"
            android:textColor="#91A8FF"
            android:textSize="17sp"
            android:textStyle="bold"

            android:layout_marginBottom="10dp" />


        <!-- =============================== -->
        <!-- КОЛИЧЕСТВО + ЕДИНИЦА -->
        <!-- =============================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="top">


            <!-- ================================= -->
            <!-- ИКОНКА КОЛИЧЕСТВА -->
            <!-- ================================= -->

            <FrameLayout
                android:layout_width="45dp"
                android:layout_height="45dp"

                android:layout_marginEnd="5dp"
                android:layout_gravity="bottom"

                android:background="@drawable/bg_quantity_icon">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:src="@drawable/ic_scale"
                    android:tint="#DDE5FF"

                    android:contentDescription="@null" />

            </FrameLayout>


            <!-- ================================= -->
            <!-- КОЛИЧЕСТВО -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">


                <TextView
                    android:id="@+id/quantityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Количество *"
                    android:textColor="#91A8FF"
                    android:textSize="11sp"

                    android:layout_marginBottom="3dp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal">

                    <!-- Поле количества -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editQuantity"

                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"

                        android:background="@drawable/bg_quantity_input"
                        android:layout_gravity="bottom"

                        android:inputType="numberDecimal"

                        android:paddingStart="10dp"
                        android:paddingEnd="6dp"

                        android:text="0.0"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#7182C0"
                        android:textSize="12sp" />


                    <LinearLayout
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_quantity_buttons">

                        <ImageButton
                            android:id="@+id/buttonQuantityUp"
                            android:layout_width="match_parent"
                            android:layout_height="17.5dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:src="@drawable/ic_arrow_up"
                            android:tint="#DDE5FF"
                            android:padding="4dp"
                            android:contentDescription="Увеличить количество" />

                        <ImageButton
                            android:id="@+id/buttonQuantityDown"
                            android:layout_width="match_parent"
                            android:layout_height="17.5dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:src="@drawable/ic_arrow_down"
                            android:tint="#DDE5FF"
                            android:padding="4dp"
                            android:contentDescription="Уменьшить количество" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================= -->
            <!-- ИКОНКА ЕДИНИЦЫ -->
            <!-- ================================= -->


            <!-- ================================= -->
            <!-- ЕДИНИЦА ИЗМЕРЕНИЯ -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/unitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Единица измерения *"
                    android:textColor="#91A8FF"
                    android:textSize="11sp"

                    android:layout_marginBottom="3dp" />


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/categoryInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"

                    android:layout_width="match_parent"
                    android:layout_height="45dp"

                    app:boxStrokeColor="@color/stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"

                    app:endIconTint="@color/white"

                    app:boxCornerRadiusTopStart="9dp"
                    app:boxCornerRadiusTopEnd="9dp"
                    app:boxCornerRadiusBottomStart="9dp"
                    app:boxCornerRadiusBottomEnd="9dp">

                    <AutoCompleteTextView
                        android:id="@+id/autoCompleteUnit"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:inputType="none"
                        android:background="@android:color/transparent"

                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"

                        android:layout_marginBottom="5dp"

                        android:textColor="@color/white"
                        android:textColorHint="#7182C0"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- =============================== -->
        <!-- РАЗДЕЛИТЕЛЬ -->
        <!-- =============================== -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"

            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"

            android:background="#344B9D" />


        <!-- =============================== -->
        <!-- ТИП ИЗМЕРЕНИЯ -->
        <!-- =============================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal"
            android:gravity="center_vertical">


            <!-- ИКОНКА -->

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:layout_marginEnd="8dp"

                android:background="@drawable/bg_measure_type_icon">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:src="@drawable/ic_straighten"

                    android:contentDescription="@null" />

            </FrameLayout>


            <!-- НАЗВАНИЕ -->

            <TextView
                android:id="@+id/measurementTypeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Тип измерения"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />


            <!-- =============================== -->
            <!-- ВЕС / ОБЪЁМ -->
            <!-- =============================== -->

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/measurementTypeGroup"

                android:layout_width="wrap_content"
                android:layout_height="40dp"

                app:singleSelection="true"
                app:selectionRequired="true"

                app:cornerRadius="9dp">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonWeight"

                    android:layout_width="90dp"
                    android:layout_height="40dp"

                    android:text="Вес"
                    android:textSize="12sp"

                    android:textColor="@color/measurement_button_text"
                    android:backgroundTint="@color/measurement_button_background"

                    app:strokeColor="@color/stroke"
                    app:strokeWidth="1dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonVolume"

                    android:layout_width="90dp"
                    android:layout_height="40dp"

                    android:text="Объём"
                    android:textSize="12sp"

                    android:textColor="@color/measurement_button_text"
                    android:backgroundTint="@color/measurement_button_background"

                    app:strokeColor="@color/stroke"
                    app:strokeWidth="1dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>