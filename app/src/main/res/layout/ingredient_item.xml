<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">


    <Button
        android:id="@+id/ButtonDelete"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:minHeight="48dp"
        android:text="Delete"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/LinearLayoutIngredient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/LinearLayoutIngredient"
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:background="@drawable/textview_border"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ButtonDelete">

        <EditText
            android:id="@+id/EditTextNameIngredient"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_marginStart="20dp"
            android:ellipsize="none"
            android:hint="name"
            android:inputType="text"
            android:paddingTop="15dp"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/my_text_view_back"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/EditTextWeight"
                android:layout_width="80dp"
                android:layout_height="50dp"
                android:background="@drawable/weight_border"
                android:gravity="center"
                android:hint="Weight"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:textColor="@color/my_text_view_back"
                android:textColorHint="@color/my_text_view_back"
                android:textSize="12sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/TextViewUnit"
                android:layout_width="70dp"
                android:layout_height="50dp"
                android:background="@drawable/weight_border"
                android:gravity="center"
                android:hint="kg"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="@color/my_text_view_back"
                android:textColorHint="#979595"
                android:textSize="13sp" />
        </FrameLayout>

        <Spinner
            android:id="@+id/SpinnerUnit"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:entries="@array/ingredients_unit"
            android:minHeight="48dp" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>